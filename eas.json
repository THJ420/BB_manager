{
  "cli": {
    "version": ">=20.0.0"
  },
  "build": {
    "dev:development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://pocket.enjoydonerkebab.pl"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://pocket.enjoydonerkebab.pl"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://pocket.enjoydonerkebab.pl"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {}
    }
  }
}