# PocketBase backend for realtime SSE + persistence.
# Copy this file to `.env` (or set the variable in eas.json / GitHub Actions).
#
# A missing or blank value is NOT a reason to disable the backend: app.config.js
# defaults `extra.pocketbaseUrl` to the production host below, so EAS and CI
# builds are always live-backed. Trailing slashes are stripped in code.
EXPO_PUBLIC_POCKETBASE_URL=https://pocket.enjoydonerkebab.pl

# To intentionally run the offline local demo dataset instead, set:
# EXPO_PUBLIC_POCKETBASE_URL=demo
